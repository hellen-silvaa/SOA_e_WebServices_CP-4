# Copie este arquivo para ".env" e ajuste os valores.
# O ".env" está no .gitignore e NÃO deve ser versionado.
# Em produção, defina estas variáveis no ambiente (não use arquivo).

# Banco de dados
DB_URL=jdbc:mysql://localhost:3306/autoescola3esr
DB_USERNAME=root
DB_PASSWORD=troque-esta-senha

# Segredo usado para assinar/verificar o token JWT (HMAC-256).
# Use algo aleatório e longo (>= 32 caracteres). Ex.: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-aleatorio-longo-de-no-minimo-32-caracteres

# Opcional
SERVER_PORT=8081
